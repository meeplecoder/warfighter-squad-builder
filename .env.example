SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///data/warfighter.db
CARDS_CSV=../cards2.csv
DEBUG=true

# --- Auth (spec/01_system.md §Authentication) ---
# Public origin for emailed links; required when DEBUG=false
APP_BASE_URL=http://localhost:5000
# PASSWORD_MIN_LENGTH=15
# LOCAL_REGISTRATION_ENABLED=true
# COOKIE_SECURE=true            # default: true unless DEBUG
# PROXY_FIX_HOPS=1              # set when behind nginx/Caddy/etc.

# --- Mail: console logs messages (dev); resend or smtp delivers ---
MAIL_BACKEND=console
# MAIL_FROM=Warfighter Squad Builder <no-reply@example.com>   # domain must be verified in Resend
# RESEND_API_KEY=re_...         # MAIL_BACKEND=resend (sending-only key is enough)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_USE_SSL=false            # true for implicit TLS on port 465
